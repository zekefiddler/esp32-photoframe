config EP_DRIVER_ED2208_NCA
    bool "E-Ink ED2208-NCA (Spectra 6 1200x1600)"
    help
        Driver for 13.3 inch Spectra 6 E-Paper displays (compatible with SeeedStudio T133A01,
        as used on the XIAO EE02 and reTerminal E1004).

config EP_ED2208_NCA_PANEL_GDEB0709E01
    # No prompt, on purpose: only the board's `select` may set it. A prompted
    # symbol is saved into sdkconfig and outlives a board change, which would
    # feed a 13.3" panel the 7.09" panel's waveform tuning without a word.
    bool
    depends on EP_DRIVER_ED2208_NCA
    default n
    help
        Use Good Display's GDEB0709E01 tuning instead of the Seeed T133A01 table:
        different PSR, analog timing, booster, DRF and POF values, plus the
        DCDC, PLL, per-controller POFS and CMDA4 commands the vendor init sends.
        Same controller family and command flow; only the parameters change.

config EP_ED2208_NCA_KEEP_RAIL_BETWEEN_DRAWS
    # Selected by boards whose panel shares its SPI bus (the reTerminal E1004's
    # SD card): clocking that bus into an unpowered controller back-feeds it
    # through its ESD diodes, so the rail stays up and the controller sleeps by
    # command. Everyone else cuts the rail after every draw.
    bool
    depends on EP_DRIVER_ED2208_NCA
    default n
